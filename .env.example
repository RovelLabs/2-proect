# Skladno Environment Variables Example
# В базовом режиме приложение работает полностью автономно (Local-First),
# поэтому запуск возможен без заполнения этих переменных.

# Порт локального сервера разработки
VITE_DEV_PORT=5173

# Опциональный публичный базовый URL для генерации коротких ссылок
VITE_APP_URL=http://localhost:5173

# Режим отладки (true / false)
VITE_ENABLE_DEBUG=false
